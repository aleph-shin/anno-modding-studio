msgstr "%s wird heruntergeladen…"

#: anno_modding_studio/core/installplan.py
msgid "mod.io has no file for it"
msgstr "mod.io hat keine Datei dafür"

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "%s has no file on mod.io any more"
msgstr "%s hat keine Datei mehr auf mod.io"

#: anno_modding_studio/core/installplan.py
#, python-format
