msgstr "%(last)s ist dein Patch für %(others)s, und sie zu überschreiben, ist seine Aufgabe"

#: anno_modding_studio/core/conflicts.py
#, python-format
msgid "%(last)s holds your changes to this loadout, and overriding %(others)s is its job"
msgstr "%(last)s enthält deine Änderungen an diesem Loadout, und %(others)s zu überschreiben ist seine Aufgabe"

#: anno_modding_studio/core/conflicts.py
#, python-format
msgid "%(last)s declares it loads after %(others)s, so it means to win here"
msgstr "%(last)s gibt an, nach %(others)s zu laden, und soll hier also gewinnen"

#: anno_modding_studio/core/conflicts.py
#, python-format
msgid "%(last)s removes this, undoing what %(others)s did here"
msgstr "%(last)s entfernt dies und hebt damit auf, was %(others)s hier geändert hat"

#: anno_modding_studio/core/conflicts.py
#, python-format
msgid "%(all)s both set this, and %(last)s wins"
msgstr "%(all)s setzen dies beide, und %(last)s gewinnt"

#: anno_modding_studio/core/conflicts.py
#, python-format
msgid "%(all)s all set this, and %(last)s wins"
msgstr "%(all)s setzen dies alle, und %(last)s gewinnt"

