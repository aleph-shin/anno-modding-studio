#, python-format
msgid "click to see all %(n)s"
msgid_plural "click to see all %(n)s"
msgstr[0] "klicken für alle %(n)s"
msgstr[1] "klicken für alle %(n)s"

#: anno_modding_studio/ui/reference_panel.py
