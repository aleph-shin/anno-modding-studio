#, python-format
msgid "iModYourAnno settings written into [[generated copy|generated copies]] of: %s."
msgstr "iModYourAnno-Einstellungen werden in [[generated copy|generierte Kopien]] geschrieben von: %s."

#: anno_modding_studio/ui/prompts.py
#, python-format
