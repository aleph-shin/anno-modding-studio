msgstr "Mod-Zips zum Installieren"

#: anno_modding_studio/ui/prompts.py
msgid "Mod zips (*.zip)"
msgstr "Mod-Zips (*.zip)"

#: anno_modding_studio/ui/prompts.py
msgid "A mod folder of your own to manage where it is"
msgstr "Eigener Ordner einer Mod, dort verwaltet, wo er liegt"

