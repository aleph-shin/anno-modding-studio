#: anno_modding_studio/ui/prompts.py
#, python-format
msgid ""
"In:\n"
"%s\n"
msgstr ""
"Ordner:\n"
"%s\n"

#: anno_modding_studio/ui/prompts.py
#, python-format
msgid ""
"Build into the Studio's library, linked in:\n"
"%s"
msgstr ""
"In die Bibliothek des Studios bauen und verlinken:\n"
"%s"

#: anno_modding_studio/ui/prompts.py
#, python-format
