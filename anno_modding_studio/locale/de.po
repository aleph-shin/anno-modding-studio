#: anno_modding_studio/ui/prompts.py
#, python-format
msgid "This loadout uses %(total)s. %(here)s, %(absent)s:"
msgstr "Dieses Loadout nutzt %(total)s. %(here)s, %(absent)s:"

#: anno_modding_studio/ui/prompts.py
#, python-format
msgid "%(n)s is installed"
msgid_plural "%(n)s are installed"
msgstr[0] "%(n)s ist installiert"
msgstr[1] "%(n)s sind installiert"

#: anno_modding_studio/ui/prompts.py
#, python-format
msgid "%(n)s is not"
msgid_plural "%(n)s are not"
msgstr[0] "%(n)s nicht"
msgstr[1] "%(n)s nicht"

