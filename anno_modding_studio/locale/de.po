msgstr[1] "%(n)s-mal installiert"

#: anno_modding_studio/core/installplan.py anno_modding_studio/ui/modio_updates_dialog.py
msgid "The game's own mod browser installed this copy. Update it there."
msgstr "Diese Kopie hat der Mod-Browser des Spiels installiert. Aktualisiere sie dort."

#: anno_modding_studio/core/installplan.py
msgid "This mod is bundled inside another. Update the mod it sits in."
msgstr "Diese Mod wird in einer anderen mitgeliefert. Aktualisiere die Mod, in der sie steckt."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "This needs about %(needed)s free and %(drive)s has %(free)s."
msgstr "Dafür werden etwa %(needed)s freier Speicher gebraucht, und %(drive)s hat %(free)s."

