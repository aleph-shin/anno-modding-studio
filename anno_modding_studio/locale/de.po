msgstr "Aktuelle Datei von %s wird bei mod.io abgefragt…"

#: anno_modding_studio/core/installplan.py anno_modding_studio/ui/library_controller.py
#, python-format
msgid "Unpacking %s…"
msgstr "%s wird entpackt…"

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "mod.io gave no checksum for %s's file, so the download couldn't be checked."
msgstr "mod.io hat für die Datei von %s keine Prüfsumme angegeben, also konnte der Download nicht geprüft werden."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "%(n)s of %(total)s installed."
msgid_plural "%(n)s of %(total)s installed."
msgstr[0] "%(n)s von %(total)s installiert."
msgstr[1] "%(n)s von %(total)s installiert."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "%(n)s could not be installed. The row shows why."
msgid_plural "%(n)s could not be installed. The row shows why."
msgstr[0] "%(n)s konnte nicht installiert werden. Die Zeile zeigt, warum."
msgstr[1] "%(n)s konnten nicht installiert werden. Die Zeile zeigt, warum."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "%(n)s skipped."
msgid_plural "%(n)s skipped."
msgstr[0] "%(n)s übersprungen."
msgstr[1] "%(n)s übersprungen."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "Stopped with %(n)s still on mod.io. It will be offered again next time."
msgid_plural "Stopped with %(n)s still on mod.io. They will be offered again next time."
msgstr[0] "Angehalten. %(n)s liegt noch auf mod.io und wird beim nächsten Mal wieder angeboten."
msgstr[1] "Angehalten. %(n)s liegen noch auf mod.io und werden beim nächsten Mal wieder angeboten."

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(n)s change, kept as the op itself"
msgid_plural "%(n)s changes, kept as the op itself"
msgstr[0] "%(n)s Änderung, als die ModOp selbst behalten"
msgstr[1] "%(n)s Änderungen, als die ModOp selbst behalten"

#: anno_modding_studio/core/keptops.py
msgid "shown in the op it edits"
msgstr "in der Op gezeigt, die sie bearbeitet"

#: anno_modding_studio/core/keptops.py
msgid "changes nothing as things stand"
msgstr "ändert nichts, so wie es jetzt steht"

#. Translators: the second half of "5 changes across 3 of 10 matching assets"; the count is of the assets the op's pattern matches.
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(some)s of %(n)s matching asset"
msgid_plural "%(some)s of %(n)s matching assets"
msgstr[0] "%(some)s von %(n)s passenden Asset"
msgstr[1] "%(some)s von %(n)s passenden Assets"

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(n)s change across %(assets)s"
msgid_plural "%(n)s changes across %(assets)s"
msgstr[0] "%(n)s Änderung in %(assets)s"
msgstr[1] "%(n)s Änderungen in %(assets)s"

#: anno_modding_studio/core/keptops.py
msgid "read from a loadout that kept only the search itself"
msgstr "aus einem Loadout gelesen, das nur die Suche selbst behalten hat"

#. Translators: why an op kept as written does not go out: it is off.
#: anno_modding_studio/core/keptops.py
msgctxt "op"
msgid "switched off"
msgstr "deaktiviert"

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(n)s of its changes is marked off, which a ModOp kept as written cannot honour: it applies to every asset it matches or to none"
msgid_plural "%(n)s of its changes are marked off, which a ModOp kept as written cannot honour: it applies to every asset it matches or to none"
msgstr[0] "%(n)s ihrer Änderungen ist abgewählt, was eine ModOp, die wie geschrieben behalten wird, nicht befolgen kann: Sie gilt für jedes Asset, auf das sie passt, oder für keines"
msgstr[1] "%(n)s ihrer Änderungen sind abgewählt, was eine ModOp, die wie geschrieben behalten wird, nicht befolgen kann: Sie gilt für jedes Asset, auf das sie passt, oder für keines"

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(n)s of its changes has been reverted from the list, which does not take the asset out of the ModOp"
msgid_plural "%(n)s of its changes have been reverted from the list, which does not take the asset out of the ModOp"
msgstr[0] "%(n)s ihrer Änderungen wurde in der Liste zurückgenommen; das nimmt das Asset nicht aus der ModOp heraus"
msgstr[1] "%(n)s ihrer Änderungen wurden in der Liste zurückgenommen; das nimmt das Asset nicht aus der ModOp heraus"

#: anno_modding_studio/core/keptops.py
msgid "it has picked up changes since it was read"
msgstr "sie hat seit dem Lesen Änderungen dazubekommen"

#. Translators: a pattern that matches %(n)s assets and changes %(some)s of them: the others are already as it would leave them.
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(some)s of %(n)s asset"
msgid_plural "%(some)s of %(n)s assets"
msgstr[0] "%(some)s von %(n)s Asset"
msgstr[1] "%(some)s von %(n)s Assets"

#: anno_modding_studio/core/keptops.py
msgid "Its target is a pattern, matched as the game loads, so it also covers assets other mods add."
msgstr "Ihr Ziel ist ein Muster. Worauf es passt, ergibt sich erst, wenn das Spiel lädt; so erfasst sie auch Assets, die andere Mods hinzufügen."

#: anno_modding_studio/core/keptops.py anno_modding_studio/ui/asset_picker.py anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/browser_panel.py
#, python-format
msgid "%(n)s match"
msgid_plural "%(n)s matches"
msgstr[0] "%(n)s Treffer"
msgstr[1] "%(n)s Treffer"

#: anno_modding_studio/core/keptops.py
msgid "Its path is a pattern inside the assets it names. What it finds there is worked out as the game loads."
msgstr "Ihr Pfad ist ein Muster innerhalb der Assets, die sie nennt. Was er dort findet, ergibt sich erst, wenn das Spiel lädt."

#. Translators: beside a ModOp whose value is worked out as the game loads: what it comes to today, as in "= 40".
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "= %s"
msgstr "= %s"

#: anno_modding_studio/core/keptops.py
msgid "Its value is copied from another place in the game's files as the game loads."
msgstr "Ihr Wert wird beim Laden des Spiels von einer anderen Stelle in den Spieldateien kopiert."

#: anno_modding_studio/core/keptops.py
msgid "It adds or takes out flags in a list as the game loads."
msgstr "Sie fügt beim Laden des Spiels Flags zu einer Liste hinzu oder nimmt sie heraus."

#: anno_modding_studio/core/keptops.py
msgid "Its value is worked out as the game loads, from the value already there or from the mod's own settings."
msgstr "Ihr Wert wird beim Laden des Spiels berechnet: aus dem Wert, der schon dort steht, oder aus den eigenen Einstellungen der Mod."

#. Translators: of a ModOp with a condition, as things stand today.
#: anno_modding_studio/core/keptops.py
msgid "runs"
msgstr "läuft"

#. Translators: of a ModOp with a condition, as things stand today.
#: anno_modding_studio/core/keptops.py
msgid "does not run"
msgstr "läuft nicht"

#: anno_modding_studio/core/keptops.py
msgid "It runs only if another mod is, or is not, loaded."
msgstr "Sie läuft nur, wenn eine andere Mod geladen ist oder nicht geladen ist."

#: anno_modding_studio/core/keptops.py
msgid "Whether it runs is one of the mod's own settings."
msgstr "Ob sie läuft, ist eine der eigenen Einstellungen der Mod."

#: anno_modding_studio/core/keptops.py
msgid "It runs only if the game's files, as the mods before it leave them, are a certain way."
msgstr "Sie läuft nur, wenn die Spieldateien, so wie die Mods vor ihr sie hinterlassen, auf eine bestimmte Weise beschaffen sind."

#: anno_modding_studio/core/keptops.py
msgid "off in the mod's file"
msgstr "in der Datei der Mod aus"

#: anno_modding_studio/core/keptops.py
msgid "The mod ships it switched off (Skip). A tweak tool may switch it on."
msgstr "Die Mod liefert sie ausgeschaltet aus (Skip). Ein Tweak-Werkzeug kann sie einschalten."

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "One of %(n)s asset matching %(search)s"
msgid_plural "One of %(n)s assets matching %(search)s"
msgstr[0] "Das einzige Asset, auf das %(search)s passt"
msgstr[1] "Eines von %(n)s Assets, auf die %(search)s passt"

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "From a search: %s"
msgstr "Aus einer Suche: %s"

#: anno_modding_studio/core/keptops.py
msgid "it is a group, and what is in it is each an op of its own"
msgstr "sie eine Gruppe ist und jede ModOp darin für sich steht"

#: anno_modding_studio/core/keptops.py
msgid "the loadout holds only its search, and not the ModOp it was"
msgstr "das Loadout nur ihre Suche enthält und nicht die ModOp, die sie war"

#: anno_modding_studio/core/keptops.py
msgid "it is switched off"
msgstr "sie ausgeschaltet ist"

#: anno_modding_studio/core/keptops.py
msgid "it is in a group, whose condition a narrow ModOp would not have"
msgstr "sie in einer Gruppe steht, deren Bedingung eine eng gefasste ModOp nicht hätte"

#: anno_modding_studio/core/keptops.py
msgid "its mod ships it switched off (Skip), for a tweak tool to switch on"
msgstr "ihre Mod sie ausgeschaltet ausliefert (Skip), damit ein Tweak-Tool sie einschaltet"

#: anno_modding_studio/core/keptops.py
msgid "it runs on a condition, which a narrow ModOp would not have"
msgstr "sie nur unter einer Bedingung läuft, die eine eng gefasste ModOp nicht hätte"

#: anno_modding_studio/core/keptops.py
msgid "what it does is shown in the op it edits, and not under it"
msgstr "das, was sie tut, in der ModOp gezeigt wird, die sie bearbeitet, und nicht unter ihr"

#: anno_modding_studio/core/keptops.py
msgid "another op of the mod edits what it adds, and is shown in it"
msgstr "eine andere ModOp der Mod bearbeitet, was sie hinzufügt, und in ihr gezeigt wird"

#: anno_modding_studio/core/keptops.py
msgid "the Studio's reading of it is known to be short"
msgstr "bekannt ist, dass das Studio sie nicht vollständig liest"

#: anno_modding_studio/core/keptops.py
msgid "it changes nothing as things stand, so there is nothing to write"
msgstr "sie derzeit nichts ändert und es deshalb nichts zu schreiben gibt"

#: anno_modding_studio/core/keptops.py
msgid "It runs only where a condition about the game files holds, which it does today. Written narrow it runs whatever they say."
msgstr "Sie läuft nur, wenn eine Bedingung zu den Spieldateien gilt, und das tut sie heute. Eng gefasst läuft sie, was immer die Dateien sagen."

#: anno_modding_studio/core/keptops.py
#, python-format
msgid "It finds what it changes as the game loads. Written narrow it is the %(n)s asset it finds today, and nothing a mod adds later."
msgid_plural "It finds what it changes as the game loads. Written narrow it is the %(n)s assets it finds today, and nothing a mod adds later."
msgstr[0] "Sie findet beim Laden des Spiels, was sie ändert. Eng gefasst ist sie das %(n)s Asset, das sie heute findet, und nichts, was eine Mod später hinzufügt."
msgstr[1] "Sie findet beim Laden des Spiels, was sie ändert. Eng gefasst ist sie die %(n)s Assets, die sie heute findet, und nichts, was eine Mod später hinzufügt."

#: anno_modding_studio/core/keptops.py
msgid "It finds the entries it changes as the game loads. Written narrow it is the ones it finds today, and not one another mod adds."
msgstr "Sie findet beim Laden des Spiels die Einträge, die sie ändert. Eng gefasst ist sie die, die sie heute findet, und keiner, den eine andere Mod hinzufügt."

#: anno_modding_studio/core/keptops.py
msgid "It copies its value from another asset. Written narrow it is the value that asset has today, and stops following it."
msgstr "Sie kopiert ihren Wert aus einem anderen Asset. Eng gefasst ist sie der Wert, den dieses Asset heute hat, und folgt ihm nicht mehr."

#: anno_modding_studio/core/keptops.py
msgid "It works its value out as the game loads. Written narrow it is the value it comes to today, and stops following the mod's settings."
msgstr "Sie berechnet ihren Wert beim Laden des Spiels. Eng gefasst ist sie der Wert, der sich heute ergibt, und folgt den Einstellungen der Mod nicht mehr."

#: anno_modding_studio/core/keptops.py
msgid "it matches nothing"
msgstr "sie passt auf nichts"

#: anno_modding_studio/core/keptops.py
msgid "its ModOp could not be read back"
msgstr "ihre ModOp ließ sich nicht zurücklesen"

#. Translators: counts of assets a pattern's search expression now matches that it did not, and matched that are gone.
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(mod)s: %(search)s now matches %(new)s new and %(gone)s gone"
msgstr "%(mod)s: %(search)s — %(new)s neu erfasst, %(gone)s nicht mehr"

#. Translators: a count of assets a pattern's search expression now matches that it did not before.
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(mod)s: %(search)s now matches %(n)s new"
msgid_plural "%(mod)s: %(search)s now matches %(n)s new"
msgstr[0] "%(mod)s: %(search)s erfasst jetzt %(n)s neues Asset"
msgstr[1] "%(mod)s: %(search)s erfasst jetzt %(n)s neue Assets"

#. Translators: a count of assets a pattern's search expression matched that are no longer there.
#: anno_modding_studio/core/keptops.py
#, python-format
msgid "%(mod)s: %(search)s now matches %(n)s gone"
msgid_plural "%(mod)s: %(search)s now matches %(n)s gone"
