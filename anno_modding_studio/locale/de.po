#: anno_modding_studio/core/dependencies.py
#, python-format
msgid "The game loads the copy %(carrier)s carries, the same version (%(version)s) as the copy in %(read)s that these rows were read from."
msgstr "Das Spiel lädt die Kopie, die %(carrier)s mitliefert, dieselbe Version (%(version)s) wie die Kopie in %(read)s, aus der diese Zeilen gelesen wurden."

