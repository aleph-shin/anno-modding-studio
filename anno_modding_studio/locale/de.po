msgstr "Eine andere Mod hat diesen Wert bereits gesetzt. Diese Mod setzt ihn auch."

#: anno_modding_studio/ui/change_rows.py
msgid "Part of a ModOp kept as written. Switch that ModOp off, not this one change."
msgstr "Teil einer ModOp, die wie geschrieben behalten wird. Schalte diese ModOp aus, nicht diese eine Änderung."

#: anno_modding_studio/ui/change_rows.py
#, python-format
msgid ""
"%(group)s\n"
"%(n)s related asset, grouped here because the base game's own references say they belong to one another."
msgid_plural ""
"%(group)s\n"
"%(n)s related assets, grouped here because the base game's own references say they belong to one another."
