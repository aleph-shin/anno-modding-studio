#. Translators: %s is a group's condition as its mod wrote it.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Condition %s"
msgstr "Bedingung %s"

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Reaches this asset and %(n)s other"
msgid_plural "Reaches this asset and %(n)s others"
msgstr[0] "Erreicht dieses Asset und %(n)s weiteres"
msgstr[1] "Erreicht dieses Asset und %(n)s weitere"

#: anno_modding_studio/ui/asset_xml.py
msgid "Not this asset's alone"
msgstr "Gehört nicht nur zu diesem Asset"

#: anno_modding_studio/ui/asset_xml.py
msgid "Its change to this asset was reverted"
msgstr "Ihre Änderung an diesem Asset wurde zurückgenommen"

#: anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/changes_dock.py
msgid "Show in file"
msgstr "In der Datei zeigen"

#: anno_modding_studio/ui/asset_xml.py
msgid "Show its group in file"
msgstr "Ihre Gruppe in der Datei zeigen"

#: anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/file_panel.py
#, python-format
msgid "And %(n)s more asset, in the Mod changes panel"
msgid_plural "And %(n)s more assets, in the Mod changes panel"
msgstr[0] "Und %(n)s weiteres Asset, im Bereich „Mod-Änderungen“"
msgstr[1] "Und %(n)s weitere Assets, im Bereich „Mod-Änderungen“"

#. Translators: said of a ModOp that finds its assets by searching.
#: anno_modding_studio/ui/asset_xml.py
msgid "Goes to what its search finds"
msgstr "Geht an das, was seine Suche findet"

#. Translators: said of a ModOp typed on one asset's page that is for another. %s is the name of that asset.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Goes to %s"
msgstr "Geht an %s"

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Goes to this asset and %(n)s other"
msgid_plural "Goes to this asset and %(n)s others"
msgstr[0] "Geht an dieses Asset und %(n)s weiteres"
msgstr[1] "Geht an dieses Asset und %(n)s weitere"

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Goes to %(n)s other asset"
msgid_plural "Goes to %(n)s other assets"
msgstr[0] "Geht an %(n)s anderes Asset"
msgstr[1] "Geht an %(n)s andere Assets"

#. Translators: read out before Apply, once for each ModOp typed that goes to another asset. %(where)s is a sentence such as "Goes to Bakery".
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Line %(line)s: %(where)s."
msgstr "Zeile %(line)s: %(where)s."

#. Translators: a button. What was typed changes a ModOp that finds its assets by searching, and how many is not known yet.
#: anno_modding_studio/ui/asset_xml.py
msgid "Apply to a search"
msgstr "Auf eine Suche anwenden"

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Apply to %(n)s asset"
msgid_plural "Apply to %(n)s assets"
msgstr[0] "Auf %(n)s Asset anwenden"
msgstr[1] "Auf %(n)s Assets anwenden"

#: anno_modding_studio/ui/asset_xml.py
msgid "The mod's ModOps for this asset changed while you were typing. Apply replaces them with what is here. Revert shows what they are now."
msgstr "Die ModOps der Mod für dieses Asset haben sich geändert, während du getippt hast. „Anwenden“ ersetzt sie durch das, was hier steht. „Zurücksetzen“ zeigt, wie sie jetzt sind."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%s does not change this asset yet. Type ModOps here, then Apply."
msgstr "%s ändert dieses Asset noch nicht. Tippe hier ModOps und klicke dann auf „Anwenden“."

#. Translators: %s is a pane's heading, while the other pane is typed in.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%s. Updates on Apply."
msgstr "%s. Wird bei „Anwenden“ aktualisiert."

#: anno_modding_studio/ui/asset_xml.py
msgid "Shut while the other pane is typed in. Apply or Revert opens it."
msgstr "Gesperrt, solange im anderen Bereich getippt wird. „Anwenden“ oder „Zurücksetzen“ gibt ihn frei."

#: anno_modding_studio/ui/asset_xml.py
msgid "Typing in the asset. Apply works out the ModOps from it, so the ModOps pane is shut until Apply or Revert."
msgstr "Du tippst im Asset. „Anwenden“ ermittelt daraus die ModOps. Deshalb ist der ModOps-Bereich bis „Anwenden“ oder „Zurücksetzen“ gesperrt."

#: anno_modding_studio/ui/asset_xml.py
msgid "Typing ModOps. Apply works out the asset from them, so the asset pane is shut until Apply or Revert."
msgstr "Du tippst ModOps. „Anwenden“ ermittelt daraus das Asset. Deshalb ist der Asset-Bereich bis „Anwenden“ oder „Zurücksetzen“ gesperrt."

#: anno_modding_studio/ui/asset_xml.py
msgid "What you typed is back in the pane, not applied."
msgstr "Was du getippt hast, steht wieder im Bereich, nicht angewendet."

#: anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/file_panel.py
#, python-format
msgid "Not applied. %s"
msgstr "Nicht angewendet. %s"

#: anno_modding_studio/ui/asset_xml.py
msgid "Not applied. The outermost element has to be <Asset>."
msgstr "Nicht angewendet. Das äußerste Element muss <Asset> sein."

#: anno_modding_studio/ui/asset_xml.py
msgid "Not applied. The GUID is what makes this the asset it is. To change another asset, open that one."
msgstr "Nicht angewendet. Die GUID macht dieses Asset zu dem, was es ist. Um ein anderes Asset zu ändern, öffne dieses."

#: anno_modding_studio/ui/asset_xml.py
msgid "Not applied. Only what is inside <Values> can be changed here."
msgstr "Nicht angewendet. Hier kann nur geändert werden, was in <Values> steht."

#: anno_modding_studio/ui/asset_xml.py
msgid "Not applied. The asset has no <Values>."
msgstr "Nicht angewendet. Das Asset hat kein <Values>."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Not applied, none of it. The change at %(path)s cannot be written as a narrow ModOp: %(why)s. Make that change in Fields, or type the ModOp for it."
msgstr "Nicht angewendet, nichts davon. Die Änderung bei %(path)s lässt sich nicht als eng gefasste ModOp schreiben: %(why)s. Mach diese Änderung unter „Felder“ oder tippe die ModOp dafür."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Not applied, none of it. A change in it cannot be written as a narrow ModOp: %s. Make that change in Fields, or type the ModOp for it."
msgstr "Nicht angewendet, nichts davon. Eine Änderung darin lässt sich nicht als eng gefasste ModOp schreiben: %s. Mach diese Änderung unter „Felder“ oder tippe die ModOp dafür."

#: anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/file_panel.py
msgid "No change to the mod."
msgstr "Keine Änderung an der Mod."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s new or changed ModOp kept as typed."
msgid_plural "%(n)s new or changed ModOps kept as typed."
msgstr[0] "%(n)s neue oder geänderte ModOp wie getippt behalten."
msgstr[1] "%(n)s neue oder geänderte ModOps wie getippt behalten."

#: anno_modding_studio/ui/asset_xml.py anno_modding_studio/ui/file_panel.py
#, python-format
msgid "%(n)s ModOp taken out."
msgid_plural "%(n)s ModOps taken out."
msgstr[0] "%(n)s ModOp entfernt."
msgstr[1] "%(n)s ModOps entfernt."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Read as %(n)s change."
msgid_plural "Read as %(n)s changes."
msgstr[0] "Als %(n)s Änderung gelesen."
msgstr[1] "Als %(n)s Änderungen gelesen."

#: anno_modding_studio/ui/asset_xml.py
msgid "Each is written as its own ModOp."
msgstr "Jede wird als eigene ModOp geschrieben."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s ModOp is kept as written."
msgid_plural "%(n)s ModOps are kept as written."
msgstr[0] "%(n)s ModOp bleibt unverändert."
msgstr[1] "%(n)s ModOps bleiben unverändert."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s ModOp changes nothing, because the asset already reads that way."
msgid_plural "%(n)s ModOps change nothing, because the asset already reads that way."
msgstr[0] "%(n)s ModOp ändert nichts, weil das Asset schon so aussieht."
msgstr[1] "%(n)s ModOps ändern nichts, weil das Asset schon so aussieht."

#. Translators: "Mod changes" is the name of the Studio's panel.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s ModOp does not reach this asset, so it is applied and listed in the Mod changes panel, not in this pane."
msgid_plural "%(n)s ModOps do not reach this asset, so they are applied and listed in the Mod changes panel, not in this pane."
msgstr[0] "%(n)s ModOp erreicht dieses Asset nicht. Sie ist deshalb angewendet und steht im Bereich „Mod-Änderungen“, nicht hier."
msgstr[1] "%(n)s ModOps erreichen dieses Asset nicht. Sie sind deshalb angewendet und stehen im Bereich „Mod-Änderungen“, nicht hier."

#. Translators: "Mod changes" is the name of the Studio's panel.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s Group is applied and listed in the Mod changes panel, not in this pane."
msgid_plural "%(n)s Groups are applied and listed in the Mod changes panel, not in this pane."
msgstr[0] "%(n)s Group ist angewendet und steht im Bereich „Mod-Änderungen“, nicht hier."
msgstr[1] "%(n)s Groups sind angewendet und stehen im Bereich „Mod-Änderungen“, nicht hier."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s ModOp could not be read and is carried as typed: %(why)s."
msgid_plural "%(n)s ModOps could not be read and are carried as typed: %(why)s."
msgstr[0] "%(n)s ModOp konnte nicht gelesen werden und wird so übernommen, wie sie getippt wurde: %(why)s."
msgstr[1] "%(n)s ModOps konnten nicht gelesen werden und werden so übernommen, wie sie getippt wurden: %(why)s."

#. Translators: "Mod changes" is the name of the Studio's panel.
#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s of them does not name this asset, and is listed in the Mod changes panel, not in this pane."
msgid_plural "%(n)s of them do not name this asset, and are listed in the Mod changes panel, not in this pane."
msgstr[0] "%(n)s davon nennt dieses Asset nicht und steht im Bereich „Mod-Änderungen“, nicht hier."
msgstr[1] "%(n)s davon nennen dieses Asset nicht und stehen im Bereich „Mod-Änderungen“, nicht hier."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s other asset was changed too: %(assets)s."
msgid_plural "%(n)s other assets were changed too: %(assets)s."
msgstr[0] "Auch %(n)s anderes Asset wurde geändert: %(assets)s."
msgstr[1] "Auch %(n)s andere Assets wurden geändert: %(assets)s."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s entry you took out only names an asset and sets nothing, so the game may not notice it gone. The removal is written all the same."
msgid_plural "%(n)s entries you took out only name an asset and set nothing, so the game may not notice them gone. The removals are written all the same."
msgstr[0] "%(n)s Eintrag, den du entfernt hast, nennt nur ein Asset und setzt nichts. Das Spiel bemerkt sein Fehlen deshalb vielleicht nicht. Das Entfernen wird trotzdem geschrieben."
msgstr[1] "%(n)s Einträge, die du entfernt hast, nennen nur ein Asset und setzen nichts. Das Spiel bemerkt ihr Fehlen deshalb vielleicht nicht. Das Entfernen wird trotzdem geschrieben."

#: anno_modding_studio/ui/asset_xml.py
msgid "Text typed between elements was left out."
msgstr "Text, der zwischen Elementen getippt wurde, wurde weggelassen."

#: anno_modding_studio/ui/asset_xml.py
msgid "The asset is not all as you typed it. It is shown as the mod's ModOps leave it."
msgstr "Das Asset ist nicht ganz so, wie du es getippt hast. Es wird so gezeigt, wie die ModOps der Mod es hinterlassen."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s group of %(mod)s kept whole reaches this asset."
msgid_plural "%(n)s groups of %(mod)s kept whole reach this asset."
msgstr[0] "%(n)s als Ganzes behaltene Gruppe von %(mod)s reicht bis zu diesem Asset."
msgstr[1] "%(n)s als Ganzes behaltene Gruppen von %(mod)s reichen bis zu diesem Asset."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "%(n)s kept ModOp of %(mod)s reaches this asset."
msgid_plural "%(n)s kept ModOps of %(mod)s reach this asset."
msgstr[0] "%(n)s behaltene ModOp von %(mod)s reicht bis zu diesem Asset."
msgstr[1] "%(n)s behaltene ModOps von %(mod)s reichen bis zu diesem Asset."

#: anno_modding_studio/ui/asset_xml.py
msgid "A group kept whole is typed over in the Mod file tab."
msgstr "Eine als Ganzes behaltene Gruppe wird im Reiter „Mod-Datei“ überschrieben."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "A mod that loads after %(mod)s writes over %(n)s field it sets: %(fields)s."
msgid_plural "Mods that load after %(mod)s write over %(n)s fields it sets: %(fields)s."
msgstr[0] "Eine Mod, die nach %(mod)s lädt, überschreibt %(n)s Feld, das sie setzt: %(fields)s."
msgstr[1] "Mods, die nach %(mod)s laden, überschreiben %(n)s Felder, die sie setzt: %(fields)s."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "Writes over %(n)s field %(mod)s sets: %(fields)s."
msgid_plural "Writes over %(n)s fields %(mod)s sets: %(fields)s."
msgstr[0] "Überschreibt %(n)s Feld, das %(mod)s setzt: %(fields)s."
msgstr[1] "Überschreibt %(n)s Felder, die %(mod)s setzt: %(fields)s."

#: anno_modding_studio/ui/asset_xml.py
msgid "What an unread ModOp does is not shown, so the asset here may differ from the game's."
msgstr "Was eine ungelesene ModOp bewirkt, wird nicht gezeigt. Das Asset hier kann also von dem des Spiels abweichen."

#: anno_modding_studio/ui/asset_xml.py
msgid "The game's loader left this asset different from what is shown. The Export tab has the comparison."
msgstr "Der Loader des Spiels hat dieses Asset anders hinterlassen, als es hier gezeigt wird. Der Tab „Export“ hat den Vergleich."

#: anno_modding_studio/ui/asset_xml.py
#, python-format
msgid "What else of %s reaches this asset, as the Studio writes it"
msgstr "Was von %s sonst noch dieses Asset erreicht, wie das Studio es schreibt"

#: anno_modding_studio/ui/asset_xml.py
msgid "A ModOp kept as written or an unread one can reach other assets too, so it is not among this asset's own ModOps."
msgstr "Eine wie geschrieben behaltene oder eine nicht gelesene ModOp kann auch andere Assets erreichen und steht deshalb nicht unter den eigenen ModOps dieses Assets."

#: anno_modding_studio/ui/background.py
msgid "Finishing background work"
msgstr "Hintergrundarbeit wird abgeschlossen"

#: anno_modding_studio/ui/background.py anno_modding_studio/ui/game_files_controller.py
msgid "Cancel"
msgstr "Abbrechen"

#: anno_modding_studio/ui/background.py
msgid "Waiting for this to finish first:"
msgstr "Zuerst wird hierauf gewartet:"

#: anno_modding_studio/ui/background.py
msgid "No background work running"
msgstr "Keine Hintergrundarbeit läuft"

#: anno_modding_studio/ui/background.py
msgid "Everything the Studio reads or checks behind the window has finished."
msgstr "Alles, was das Studio hinter dem Fenster einliest oder prüft, ist abgeschlossen."

#. Translators: %(task)s is what is running, as in "Reading 3 mods again…"; %(n)s is how many other things are as well.
#: anno_modding_studio/ui/background.py
#, python-format
msgid "%(task)s (and %(n)s more)"
msgid_plural "%(task)s (and %(n)s more)"
msgstr[0] "%(task)s (und %(n)s weitere)"
msgstr[1] "%(task)s (und %(n)s weitere)"

#: anno_modding_studio/ui/backup_dialog.py
msgid "Restore mods from a backup"
msgstr "Mods aus einer Sicherung wiederherstellen"

#: anno_modding_studio/ui/backup_dialog.py anno_modding_studio/ui/folders_dialog.py
msgid "Backups"
msgstr "Sicherungen"

#: anno_modding_studio/ui/backup_dialog.py
msgid "&Restore these files"
msgstr "Diese Dateien &wiederherstellen"

#: anno_modding_studio/ui/backup_dialog.py
msgid "No copies are saved for this folder yet. One is made the first time an export overwrites a mod that is already there."
msgstr "Für diesen Ordner sind noch keine Kopien gesichert. Eine entsteht, sobald ein Export zum ersten Mal eine Mod überschreibt, die schon da ist."

#: anno_modding_studio/ui/backup_dialog.py
#, python-format
msgid "%(n)s file, %(size)s MB, from %(folder)s.  Restoring overwrites that file and nothing else."
msgid_plural "%(n)s files, %(size)s MB, from %(folder)s.  Restoring overwrites those files and nothing else."
msgstr[0] "%(n)s Datei, %(size)s MB, aus %(folder)s.  Wiederherstellen überschreibt diese Datei und sonst nichts."
msgstr[1] "%(n)s Dateien, %(size)s MB, aus %(folder)s.  Wiederherstellen überschreibt diese Dateien und sonst nichts."

#: anno_modding_studio/ui/backup_dialog.py
msgid "Every mod in it is in the library now, so there is nothing here to restore. Undoing the conversion to the library, in the Library menu, moves them back and restores their files."
msgstr "Jede Mod darin liegt jetzt in der Bibliothek, hier gibt es also nichts wiederherzustellen. Wird die Umstellung auf die Bibliothek im Menü Bibliothek rückgängig gemacht, kommen sie zurück und ihre Dateien werden wiederhergestellt."

#: anno_modding_studio/ui/backup_dialog.py
#, python-format
msgid "%(n)s of its mods is in the library now and is left as it is. Undoing the conversion to the library, in the Library menu, moves it back and restores its files."
msgid_plural "%(n)s of its mods are in the library now and are left as they are. Undoing the conversion to the library, in the Library menu, moves them back and restores their files."
msgstr[0] "%(n)s ihrer Mods liegt jetzt in der Bibliothek und bleibt, wie sie ist. Wird die Umstellung auf die Bibliothek im Menü Bibliothek rückgängig gemacht, kommt sie zurück und ihre Dateien werden wiederhergestellt."
msgstr[1] "%(n)s ihrer Mods liegen jetzt in der Bibliothek und bleiben, wie sie sind. Wird die Umstellung auf die Bibliothek im Menü Bibliothek rückgängig gemacht, kommen sie zurück und ihre Dateien werden wiederhergestellt."

#: anno_modding_studio/ui/backup_dialog.py
msgid "Restore these files?"
msgstr "Diese Dateien wiederherstellen?"

#: anno_modding_studio/ui/backup_dialog.py
#, python-format
msgid ""
"Put %(n)s file back into:\n"
"%(folder)s\n"
"\n"
"This overwrites whatever the Studio wrote there since %(when)s. Other files in the folder are not changed."
msgid_plural ""
"Put %(n)s files back into:\n"
"%(folder)s\n"
"\n"
"This overwrites whatever the Studio wrote there since %(when)s. Other files in the folder are not changed."
msgstr[0] ""
"%(n)s Datei zurücklegen nach:\n"
"%(folder)s\n"
"\n"
"Das überschreibt alles, was das Studio seit dem %(when)s dort geschrieben hat. Andere Dateien im Ordner werden nicht verändert."
msgstr[1] ""
"%(n)s Dateien zurücklegen nach:\n"
"%(folder)s\n"
"\n"
"Das überschreibt alles, was das Studio seit dem %(when)s dort geschrieben hat. Andere Dateien im Ordner werden nicht verändert."

#: anno_modding_studio/ui/backup_dialog.py anno_modding_studio/ui/history_dialog.py
msgid "&Restore"
msgstr "&Wiederherstellen"

#: anno_modding_studio/ui/backup_dialog.py
msgid "Some files could not be restored"
msgstr "Einige Dateien konnten nicht wiederhergestellt werden"

#: anno_modding_studio/ui/backup_dialog.py
msgid "Restored"
msgstr "Wiederhergestellt"

#: anno_modding_studio/ui/backup_dialog.py
#, python-format
msgid ""
"Put %(n)s file back.\n"
"\n"
"The mods are as they were. Read the folder again to bring that into this loadout."
msgid_plural ""
"Put %(n)s files back.\n"
"\n"
"The mods are as they were. Read the folder again to bring that into this loadout."
msgstr[0] ""
"%(n)s Datei zurückgelegt.\n"
"\n"
"Die Mods sind wieder wie vorher. Lies den Ordner erneut ein, um das in dieses Loadout zu übernehmen."
msgstr[1] ""
"%(n)s Dateien zurückgelegt.\n"
"\n"
"Die Mods sind wieder wie vorher. Lies den Ordner erneut ein, um das in dieses Loadout zu übernehmen."

#: anno_modding_studio/ui/browser_panel.py
msgid "Search assets…  (e.g. “lumberjack”, “1010340”, “residence tier01”)"
msgstr "Assets suchen…  (z. B. „lumberjack“, „1010340“, „residence tier01“)"

#: anno_modding_studio/ui/browser_panel.py
msgid "Search assets"
msgstr "Assets suchen"

#. Translators: a button beside the asset search box; the verb.
#: anno_modding_studio/ui/browser_panel.py anno_modding_studio/ui/source_panel.py
msgid "Clear"
msgstr "Leeren"

#: anno_modding_studio/ui/browser_panel.py
msgid "Clear the search and close the result list."
msgstr "Suche leeren und die Ergebnisliste schließen."

#: anno_modding_studio/ui/browser_panel.py
msgid "Search by in-game name, internal name, GUID, or template, then narrow down with the template filter. Pick a row to start editing it."
msgstr "Suche nach Namen im Spiel, internem Namen, GUID oder Template und grenze dann mit dem Template-Filter ein. Wähle eine Zeile, um sie zu bearbeiten."

#: anno_modding_studio/ui/browser_panel.py anno_modding_studio/ui/modio_get_dialog.py
msgid "Search results"
msgstr "Suchergebnisse"

#: anno_modding_studio/ui/browser_panel.py
msgid "Load a base asset file on the Start tab first."
msgstr "Lade zuerst im Tab „Start“ eine Basis-Asset-Datei."

#: anno_modding_studio/ui/browser_panel.py
msgid "No assets match. Try fewer words, or clear the filters."
msgstr "Kein Asset passt. Versuche weniger Wörter oder setze die Filter zurück."

#: anno_modding_studio/ui/browser_panel.py
#, python-format
msgid "Showing the best of %(total)s matches. Refine your search to see the rest."
msgid_plural "Showing the %(n)s best of %(total)s matches. Refine your search to see the rest."
msgstr[0] "Gezeigt wird der beste von %(total)s Treffern. Verfeinere die Suche, um den Rest zu sehen."
msgstr[1] "Gezeigt werden die %(n)s besten von %(total)s Treffern. Verfeinere die Suche, um den Rest zu sehen."

#: anno_modding_studio/ui/browser_panel.py anno_modding_studio/ui/changes_dock.py anno_modding_studio/ui/conflicts_dialog.py
msgid "Open in asset editor"
msgstr "Im Asset-Editor öffnen"

#: anno_modding_studio/ui/browser_panel.py
msgid "References for this asset…"
msgstr "Verweise für dieses Asset…"

#: anno_modding_studio/ui/browser_panel.py anno_modding_studio/ui/conflicts_dialog.py anno_modding_studio/ui/reference_panel.py
msgid "Copy GUID"
msgstr "GUID kopieren"

#: anno_modding_studio/ui/browser_panel.py
msgid "Copy internal name"
msgstr "Internen Namen kopieren"

#: anno_modding_studio/ui/browser_panel.py
