#: anno_modding_studio/ui/options_editor_dialog.py
msgid "Add a cho&ice"
msgstr "Möglichkeit hinzu&fügen"

#: anno_modding_studio/ui/options_editor_dialog.py
msgid "Remo&ve the choice"
msgstr "Möglichkeit &löschen"

#: anno_modding_studio/ui/options_editor_dialog.py
msgctxt "slider"
msgid "Lowe&st"
msgstr "&Kleinster Wert"

#: anno_modding_studio/ui/options_editor_dialog.py
