#: anno_modding_studio/ui/scripts_dialog.py
msgid "New module"
msgstr "Neues Modul"

#: anno_modding_studio/ui/scripts_dialog.py
msgctxt "Lua module"
msgid "&File"
msgstr "&Datei"

#. Translators: Modules and Init are keys of a modinfo's Scripts block, and stay as they are; a global is a Lua variable every script sees.
#: anno_modding_studio/ui/scripts_dialog.py
msgid "The file is written from the loader's template into the mod's scripts folder, listed under Modules, and required into a global by Init. The names are suggested from the Mod ID and differ from those of every loaded mod."
msgstr "Die Datei wird aus der Vorlage des Loaders in den Skriptordner der Mod geschrieben, unter Modules aufgeführt und von Init in eine globale Variable geladen. Die Namen werden aus der ModID vorgeschlagen und unterscheiden sich von denen jeder geladenen Mod."

#. Translators: the Lua global the module is kept in.
#: anno_modding_studio/ui/scripts_dialog.py
msgctxt "Lua variable"
msgid "&Global"
msgstr "&Globale Variable"

#. Translators: followed by the loader's hooks, Load, Unload and Tick.
#: anno_modding_studio/ui/scripts_dialog.py
msgid "Called on"
msgstr "Aufgerufen bei"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "The file name needs letters, digits, - or _."
msgstr "Der Dateiname darf nur Buchstaben, Ziffern, - oder _ enthalten."

#: anno_modding_studio/ui/scripts_dialog.py
msgid "The global has to be a Lua name: a letter or _, then letters, digits or _."
msgstr "Die globale Variable braucht einen Lua-Namen: einen Buchstaben oder _, danach Buchstaben, Ziffern oder _."

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "A loading mod already has a module %s.lua."
msgstr "Eine geladene Mod hat schon ein Modul %s.lua."

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "A loading mod already sets the global %s."
msgstr "Eine geladene Mod setzt schon die globale Variable %s."

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "Scripts: %s"
msgstr "Skripte: %s"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "&Choose folder…"
msgstr "Ordner &wählen…"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "Where this mod's Lua is on this machine. Exporting copies it into the mod."
msgstr "Wo das Lua dieser Mod auf diesem Rechner liegt. Der Export kopiert es in die Mod."

#. Translators: Init, Load, Unload and Tick are the loader's names for those moments, and stay as they are.
#: anno_modding_studio/ui/scripts_dialog.py
msgid "Anno 117 runs the Lua that a mod's modinfo lists: its modules, and a snippet for each moment. Init runs once the mods are loaded, Load and Unload with a game, and Tick while it runs. The loader calls this experimental. Write the Lua in an editor made for it. This dialog edits what the modinfo lists."
msgstr "Anno 117 führt das Lua aus, das die modinfo einer Mod aufführt: ihre Module und einen Schnipsel für jeden Zeitpunkt. Init läuft, sobald die Mods geladen sind, Load und Unload mit einem Spielstand und Tick, während er läuft. Der Loader nennt das experimentell. Schreib das Lua in einem Editor, der dafür gemacht ist. Dieser Dialog bearbeitet, was die modinfo aufführt."

#. Translators: the Lua modules the modinfo lists.
#: anno_modding_studio/ui/scripts_dialog.py
msgid "&Modules"
msgstr "&Module"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "&New module…"
msgstr "&Neues Modul…"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "&Add a file…"
msgstr "Datei &hinzufügen…"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "Takes it off the list. The file stays where it is."
msgstr "Nimmt es aus der Liste. Die Datei bleibt, wo sie ist."

#: anno_modding_studio/ui/scripts_dialog.py
msgctxt "verb"
msgid "&Open"
msgstr "Ö&ffnen"

#. Translators: %s is one of the loader's hooks: Init, Load, Unload, Tick.
#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "Lua run on %s"
msgstr "Lua, das bei %s läuft"

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "Lua files in %s"
msgstr "Lua-Dateien in %s"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "This mod has no folder yet, so its module files cannot be looked for."
msgstr "Diese Mod hat noch keinen Ordner, also kann nicht nach ihren Moduldateien gesucht werden."

#: anno_modding_studio/ui/scripts_dialog.py
msgid "No folder is chosen for this mod's Lua yet."
msgstr "Für das Lua dieser Mod ist noch kein Ordner gewählt."

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "%s  (new, written when you press OK)"
msgstr "%s  (neu, wird beim Klick auf OK geschrieben)"

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "%s  (not in the folder)"
msgstr "%s  (nicht im Ordner)"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "This mod has no folder yet to write a module into."
msgstr "Diese Mod hat noch keinen Ordner, in den ein Modul geschrieben werden könnte."

#: anno_modding_studio/ui/scripts_dialog.py
msgid "Where this mod's Lua lives"
msgstr "Wo das Lua dieser Mod liegt"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "A module of this mod's"
msgstr "Ein Modul dieser Mod"

#: anno_modding_studio/ui/scripts_dialog.py
msgid "Not in this mod"
msgstr "Nicht in dieser Mod"

#: anno_modding_studio/ui/scripts_dialog.py
#, python-format
msgid "A module's path is read from the mod's own folder, so the file has to be in %s."
msgstr "Der Pfad eines Moduls wird vom eigenen Ordner der Mod aus gelesen, also muss die Datei in %s liegen."

#: anno_modding_studio/ui/scripts_dialog.py
msgid "Could not write the module"
msgstr "Modul konnte nicht geschrieben werden"

#: anno_modding_studio/ui/settings_dialog.py
msgid "General"
msgstr "Allgemein"

#: anno_modding_studio/ui/settings_dialog.py
msgid "Authoring"
msgstr "Mods erstellen"

#: anno_modding_studio/ui/settings_dialog.py
