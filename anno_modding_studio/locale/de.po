#, python-format
msgid "%(row)s in %(mod)s, as the Studio writes it"
msgstr "%(row)s in %(mod)s, wie das Studio es schreibt"

#: anno_modding_studio/ui/changes_dock.py
#, python-format
msgid "%(n)s row of %(mod)s, as the Studio writes it"
msgid_plural "%(n)s rows of %(mod)s, as the Studio writes them"
msgstr[0] "%(n)s Zeile aus %(mod)s, wie das Studio sie schreibt"
msgstr[1] "%(n)s Zeilen aus %(mod)s, wie das Studio sie schreibt"

#: anno_modding_studio/ui/changes_dock.py
#, python-format
msgid "Discard the one change in this loadout? It is the only change of the %(mods)s mods loaded in it."
msgid_plural "Discard all %(n)s changes in this loadout? That is every change of all %(mods)s mods loaded in it."
