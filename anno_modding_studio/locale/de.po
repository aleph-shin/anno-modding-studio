msgstr[1] "%(n)s darin deaktivierte Mods würden ausgeschaltet"

#. Translators: a count of mods the loadout does not have at all.
#: anno_modding_studio/core/truth.py
#, python-format
msgid "%(n)s mod that is not in it would be switched off"
msgid_plural "%(n)s mods that are not in it would be switched off"
msgstr[0] "%(n)s Mod, die nicht dazugehört, würde ausgeschaltet"
msgstr[1] "%(n)s Mods, die nicht dazugehören, würden ausgeschaltet"

#. Translators: a count of mods that load and the Studio cannot switch off.
#: anno_modding_studio/core/truth.py
#, python-format
msgid "%(n)s mod the game's own mod browser installed would stay on"
msgid_plural "%(n)s mods the game's own mod browser installed would stay on"
msgstr[0] "%(n)s vom Mod-Browser des Spiels installierte Mod bliebe eingeschaltet"
msgstr[1] "%(n)s vom Mod-Browser des Spiels installierte Mods blieben eingeschaltet"

#. Translators: "Play" is the Studio's button that makes the loadout what the game loads and starts it; %(subject)s is "this loadout" or a profile's name.
#: anno_modding_studio/core/truth.py
#, python-format
msgid "Play would make %(subject)s what the game loads: %(what)s."
msgstr "„Spielen“ würde %(subject)s zu dem machen, was das Spiel lädt: %(what)s."

#. Translators: the Play card's header when what the loadout has on is exactly what the game loads.
#: anno_modding_studio/core/truth.py
msgctxt "the game loads it"
msgid "Matches"
msgstr "Stimmt überein"

#. Translators: a count of mods, on the Play card's header.
#: anno_modding_studio/core/truth.py
#, python-format
msgid "%(n)s the Studio cannot switch"
msgid_plural "%(n)s the Studio cannot switch"
msgstr[0] "%(n)s Mod, die das Studio nicht umschalten kann"
msgstr[1] "%(n)s Mods, die das Studio nicht umschalten kann"

#. Translators: a count of mods, on the Play card's header.
#: anno_modding_studio/core/truth.py
#, python-format
msgid "%(n)s changed since it was made live"
msgid_plural "%(n)s changed since it was made live"
msgstr[0] "%(n)s Mod seit dem Live-Schalten geändert"
msgstr[1] "%(n)s Mods seit dem Live-Schalten geändert"

#. Translators: a profile's name, and a count of mods.
