#, python-format
msgid "Your Studio data in %(folder)s was last used by version %(version)s, which keeps it in a newer way than this version (%(this)s) can read. Start that version or a later one to carry on with it. The folder is left as that version left it."
msgstr "Deine Studio-Daten in %(folder)s wurden zuletzt von Version %(version)s verwendet. Sie speichert sie auf eine neuere Art, als diese Version (%(this)s) lesen kann. Starte diese Version oder eine neuere, um damit weiterzuarbeiten. Der Ordner bleibt, wie diese Version ihn hinterlassen hat."

#: anno_modding_studio/core/dataversion.py
#, python-format
msgid "Your Studio data in %(folder)s was last used by a newer version, which keeps it in a way this version (%(this)s) can't read. Start the newest version you have to carry on with it. The folder is left as that version left it."
msgstr "Deine Studio-Daten in %(folder)s wurden zuletzt von einer neueren Version verwendet. Sie speichert sie auf eine Art, die diese Version (%(this)s) nicht lesen kann. Starte die neueste Version, die du hast, um damit weiterzuarbeiten. Der Ordner bleibt, wie jene Version ihn hinterlassen hat."

#: anno_modding_studio/core/declaring.py
msgid "An option has no name."
msgstr "Eine Option hat keinen Namen."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "“%s” cannot name an option: it takes a letter or _, then letters, digits, - or _."
msgstr "„%s“ kann keine Option benennen: Am Anfang steht ein Buchstabe oder _, danach Buchstaben, Ziffern, - oder _."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "Two options are called %s."
msgstr "Zwei Optionen heißen %s."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "%s is a toggle: its default is true or false."
msgstr "%s ist ein Schalter: Seine Vorgabe ist true oder false."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "%s is a toggle: it is shown with two words or none."
msgstr "%s ist ein Schalter: Er wird mit zwei Wörtern angezeigt oder mit keinem."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "Every choice of %s needs a value."
msgstr "Jede Auswahlmöglichkeit von %s braucht einen Wert."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "Two choices of %s have the same value."
msgstr "Zwei Auswahlmöglichkeiten von %s haben denselben Wert."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "The default of %s is not one of its choices."
msgstr "Die Vorgabe von %s ist keine ihrer Auswahlmöglichkeiten."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "Each choice of %s is shown as something, or none is."
msgstr "Entweder wird jede Auswahlmöglichkeit von %s als etwas angezeigt oder keine."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "The lowest, highest and step of %s are numbers."
msgstr "Kleinster Wert, größter Wert und Schrittweite von %s sind Zahlen."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "%s runs from a lower number to a higher one, in steps above 0."
msgstr "%s reicht von einer kleineren Zahl zu einer größeren, in Schritten über 0."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "The default of %s is a number."
msgstr "Die Vorgabe von %s ist eine Zahl."

#: anno_modding_studio/core/declaring.py
#, python-format
msgid "The default of %s is between its lowest and highest."
msgstr "Die Vorgabe von %s liegt zwischen ihrem kleinsten und größten Wert."

#. Translators: one of a mod's options, by its label, where a row says what a group or a ModOp asks.
#: anno_modding_studio/core/declaring.py
#, python-format
msgid "option “%s”"
msgstr "Option „%s“"

