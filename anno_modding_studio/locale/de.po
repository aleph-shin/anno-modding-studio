msgstr[1] "Für die übrigen %(n)s Mods werden %(size)s heruntergeladen. Installiert belegen sie etwa %(room)s."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "Installing the %(n)s ticked will download %(size)s and use about %(room)s."
msgid_plural "Installing the %(n)s ticked will download %(size)s and use about %(room)s."
msgstr[0] "Für die angehakte Mod werden %(size)s heruntergeladen. Installiert belegt sie etwa %(room)s."
msgstr[1] "Für die %(n)s angehakten Mods werden %(size)s heruntergeladen. Installiert belegen sie etwa %(room)s."

#: anno_modding_studio/core/installplan.py
#, python-format
msgid "This mod is already installed."
