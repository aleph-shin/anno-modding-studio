msgstr "%(stamp)s: %(what)s"

#: anno_modding_studio/core/backup.py
#, python-format
msgid "%s: this mod is in the library now, behind a link, so it is left as it is. Undoing the conversion to the library moves it back and restores its files."
msgstr "%s: Diese Mod liegt jetzt in der Bibliothek, hinter einer Verknüpfung, und bleibt, wie sie ist. Wird die Umstellung auf die Bibliothek rückgängig gemacht, kommt sie zurück und ihre Dateien werden wiederhergestellt."

#: anno_modding_studio/core/backup.py
#, python-format
msgid "%s: that is not inside the mods folder this was saved from"
msgstr "%s: liegt nicht in dem Mod-Ordner, aus dem diese Sicherung stammt"

#: anno_modding_studio/core/backup.py
#, python-format
msgid "%s: the copy is missing"
msgstr "%s: die Kopie fehlt"

#: anno_modding_studio/core/backup.py
#, python-format
msgid "%(path)s: this save does not record where the file lives. Its copy is %(copy)s"
msgstr "%(path)s: Diese Sicherung hält nicht fest, wo die Datei hingehört. Ihre Kopie liegt unter %(copy)s"

#: anno_modding_studio/core/build.py
#, python-format
msgid "%s in the mods folder is a folder of your own, not the Studio's build, so the mod was not built"
msgstr "%s im Mod-Ordner ist ein eigener Ordner von dir, kein Build des Studios, also wurde die Mod nicht gebaut"

#: anno_modding_studio/core/builtby.py
#, python-format
msgid "%(mod)s was not built: %(folder)s in the library is the build of another project, %(project)s, and only that project builds it. Open a loadout that has that project to change the mod, or give this one another name."
msgstr "%(mod)s wurde nicht gebaut: %(folder)s in der Bibliothek ist der Build eines anderen Projekts, %(project)s, und nur dieses Projekt baut ihn. Öffne ein Loadout mit diesem Projekt, um die Mod zu ändern, oder gib dieser hier einen anderen Namen."

