#, python-format
msgid "%(n)s bundled copy of a mod already loaded"
msgid_plural "%(n)s bundled copies of a mod already loaded"
msgstr[0] "%(n)s mitgelieferte Kopie einer bereits geladenen Mod"
msgstr[1] "%(n)s mitgelieferte Kopien einer bereits geladenen Mod"

#: anno_modding_studio/core/reader.py
msgid "Working out the order the game loads them in…"
msgstr "Die Ladereihenfolge des Spiels wird ermittelt…"

#: anno_modding_studio/core/reader.py
#, python-format
msgid "Turning %(n)s ModOp into changes…"
msgid_plural "Turning %(n)s ModOps into changes…"
msgstr[0] "%(n)s ModOp wird in Änderungen umgewandelt…"
msgstr[1] "%(n)s ModOps werden in Änderungen umgewandelt…"

#: anno_modding_studio/core/reader.py
msgid "Sorting the changes into their mods…"
msgstr "Die Änderungen werden ihren Mods zugeordnet…"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "an expression too long for the Studio to work out"
msgstr "ein Ausdruck, der für das Studio zu lang zum Berechnen ist"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "%r is not an expression the Studio can work out"
msgstr "%r ist kein Ausdruck, den das Studio berechnen kann"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "%r nests deeper than the Studio will follow"
msgstr "%r ist tiefer verschachtelt, als das Studio folgt"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "%r is not arithmetic"
msgstr "%r ist keine Arithmetik"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "%r does not come to a number"
msgstr "%r ergibt keine Zahl"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "an empty expression"
msgstr "ein leerer Ausdruck"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "the mod's %s option is not declared"
msgstr "die Option %s der Mod ist nicht deklariert"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it builds on a value the target does not have"
msgstr "sie baut auf einem Wert auf, den das Ziel nicht hat"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "%r divides by zero"
msgstr "%r teilt durch null"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it puts what it copies straight into the op, beside text or as text, where the loader's documentation does not say what comes of it"
msgstr "sie setzt das Kopierte direkt in die Op, neben Text oder als Text, und die Dokumentation des Loaders sagt nicht, was daraus wird"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "its condition already holds, so it is no longer needed"
msgstr "ihre Bedingung ist schon erfüllt, sie wird also nicht mehr gebraucht"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "kept as written: %s"
msgstr "unverändert behalten: %s"

#. Translators: follows "it matches nothing here, which its author allows (AllowNoMatch)" -- with other mods loaded, it may match something.
#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "with other mods it may"
msgstr "mit anderen Mods vielleicht schon"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "a computed value with nothing to put it in"
msgstr "ein berechneter Wert ohne Ort, an den er gehört"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it builds on the field's own value (self::node()) in a field it puts into the file, which has no value yet: the game writes NaN there"
msgstr "sie baut auf dem eigenen Wert des Feldes auf (self::node()), in einem Feld, das sie in die Datei setzt und das noch keinen Wert hat: Das Spiel schreibt dort NaN"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "it computes a value into <%s>, which is a section and not a field"
msgstr "sie berechnet einen Wert in <%s>, das ein Abschnitt ist und kein Feld"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it works a value out with text of its own after it in a field it puts into the file, and what the game makes of the two there is not known"
msgstr "sie berechnet einen Wert mit eigenem Text dahinter in einem Feld, das sie in die Datei setzt, und was das Spiel dort aus beidem macht, ist nicht bekannt"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "a computed value beside other fields"
msgstr "ein berechneter Wert neben anderen Feldern"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it works a value out after text of its own in a field it puts into the file, and there the game leaves the mark as written"
msgstr "sie berechnet einen Wert hinter eigenem Text in einem Feld, das sie in die Datei setzt, und dort lässt das Spiel die Marke wie geschrieben stehen"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it works a value out after text standing loose among the elements it puts into the file, and there the loader leaves the mark as written"
msgstr "sie berechnet einen Wert hinter Text, der lose zwischen den Elementen steht, die sie in die Datei setzt, und dort lässt der Loader die Marke wie geschrieben stehen"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "it works a value out after the empty element <%s> in what it puts into the file, and there the game leaves every such mark as written and its field with no value"
msgstr "sie berechnet einen Wert hinter dem leeren Element <%s> in dem, was sie in die Datei setzt, und dort lässt das Spiel jede solche Marke wie geschrieben stehen und ihr Feld ohne Wert"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "it copies %s in an op that is not a merge, and what the game does with such a copy there is not known"
msgstr "sie kopiert %s in einer Op, die kein Merge ist, und was das Spiel dort mit einer solchen Kopie macht, ist nicht bekannt"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it replaces a field with a value worked out and no element around it, which leaves the game with no such field"
msgstr "sie ersetzt ein Feld durch einen berechneten Wert ohne Element darum, wonach das Spiel kein solches Feld mehr hat"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it computes a value with no field to put it in"
msgstr "sie berechnet einen Wert, für den es kein Feld gibt"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it adds or takes out flags in an op that is not a merge, and whether the game does that there is not known"
msgstr "sie fügt Flags in einer Op hinzu oder nimmt sie heraus, die kein Merge ist, und ob das Spiel das dort tut, ist nicht bekannt"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "flags with no field to go in"
msgstr "Flags ohne Feld, in das sie gehören"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "flags and a computed value in one field"
msgstr "Flags und ein berechneter Wert in einem Feld"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "it merges flags into <%s>, which is a section and not a field"
msgstr "sie mischt Flags in <%s> ein, das ein Abschnitt ist und kein Feld"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "flags beside other fields"
msgstr "Flags neben anderen Feldern"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it copies from beside a field the Studio cannot place"
msgstr "sie kopiert relativ zu einem Feld, das das Studio nicht zuordnen kann"

#: anno_modding_studio/core/reader.py
msgctxt "stored"
msgid "it copies from beside a field the game does not have"
msgstr "sie kopiert relativ zu einem Feld, das es im Spiel nicht gibt"

#: anno_modding_studio/core/recording.py
#, python-format
msgctxt "stored"
msgid "its %(count)d <%(tag)s> entries have nothing unique to match them on"
msgstr "ihre %(count)d <%(tag)s>-Einträge haben nichts Eindeutiges, woran sie sich zuordnen ließen"

#: anno_modding_studio/core/recording.py
#, python-format
msgctxt "stored"
msgid "<%s> holds a value in your assets.xml and a container in the mod"
msgstr "<%s> enthält in deiner assets.xml einen Wert und in der Mod einen Container"

#: anno_modding_studio/core/recording.py
#, python-format
msgctxt "stored"
msgid "<%s> holds a container in your assets.xml and a value in the mod"
msgstr "<%s> enthält in deiner assets.xml einen Container und in der Mod einen Wert"

#: anno_modding_studio/core/recording.py
msgctxt "stored"
msgid "a <ModItem> whose key is met twice in the list, so it merges into the first of them, which no path can say"
msgstr "ein <ModItem>, dessen Schlüssel in der Liste zweimal vorkommt, sodass es in den ersten der beiden Einträge gemergt wird, was kein Pfad ausdrücken kann"

#: anno_modding_studio/core/recording.py
msgctxt "stored"
msgid "a <ModItem> that says nothing the Studio can match an entry by"
msgstr "ein <ModItem>, das nichts angibt, woran das Studio einen Eintrag zuordnen kann"

#: anno_modding_studio/core/recording.py
#, python-format
msgctxt "stored"
msgid "a <ModItem> whose %s= names an entry that is not there"
msgstr "ein <ModItem>, dessen %s= einen Eintrag nennt, den es nicht gibt"

#: anno_modding_studio/core/recording.py
msgctxt "stored"
msgid "a <ModItem> that both finds its entry and says where to put it, which the loader leaves an attribute behind for"
msgstr "ein <ModItem>, das seinen Eintrag sowohl findet als auch angibt, wohin er gehört — dabei lässt der Loader ein Attribut zurück"

#: anno_modding_studio/core/records.py
#, python-format
msgid "%(file)s was written by version %(version)s of the Studio, which keeps it in a newer way than this version (%(this)s) can read. It is left as it is. Start that version or a later one to change it."
msgstr "%(file)s wurde von Version %(version)s des Studios geschrieben. Sie speichert die Datei auf eine neuere Art, als diese Version (%(this)s) lesen kann. Die Datei bleibt, wie sie ist. Starte diese Version oder eine neuere, um sie zu ändern."

#: anno_modding_studio/core/records.py
#, python-format
msgid "%(file)s was written by a newer version of the Studio, in a way this version (%(this)s) can't read. It is left as it is. Start the newest version you have to change it."
msgstr "%(file)s wurde von einer neueren Version des Studios geschrieben, auf eine Art, die diese Version (%(this)s) nicht lesen kann. Die Datei bleibt, wie sie ist. Starte die neueste Version, die du hast, um sie zu ändern."

#: anno_modding_studio/core/records.py
#, python-format
msgid "%(file)s can't be read as one of the Studio's records, so it is left as it is, and not written over. Move it out of %(folder)s, or put back a copy from a backup, and try again."
msgstr "%(file)s lässt sich nicht als Aufzeichnung des Studios lesen. Deshalb bleibt die Datei, wie sie ist, und wird nicht überschrieben. Verschiebe sie aus %(folder)s oder lege eine Kopie aus einer Sicherung zurück und versuch es noch einmal."

#: anno_modding_studio/core/refs.py
msgid "Named as a GUID, so this is a link."
msgstr "Als GUID benannt, also ist das ein Verweis."

#: anno_modding_studio/core/refs.py
#, python-format
msgid "Only %(n)s value in the base game to judge by, so this link is a guess."
msgid_plural "Only %(n)s values in the base game to judge by, so this link is a guess."
msgstr[0] "Nur %(n)s Wert im Basisspiel zum Vergleich, daher ist dieser Verweis geraten."
msgstr[1] "Nur %(n)s Werte im Basisspiel zum Vergleich, daher ist dieser Verweis geraten."

#: anno_modding_studio/core/refs.py
msgid "Most of the GUIDs in this field are plain numbers elsewhere in the game, so this may be a coincidence and not a link."
msgstr "Die meisten GUIDs in diesem Feld sind anderswo im Spiel einfache Zahlen, daher ist das vielleicht Zufall und kein Verweis."

#: anno_modding_studio/core/refs.py
#, python-format
msgid "%(rate)s%% of the %(n)s value in this field are asset GUIDs, so this is a link."
msgid_plural "%(rate)s%% of the %(n)s values in this field are asset GUIDs, so this is a link."
msgstr[0] "%(rate)s %% des %(n)s Werts in diesem Feld sind Asset-GUIDs, also ist das ein Verweis."
msgstr[1] "%(rate)s %% der %(n)s Werte in diesem Feld sind Asset-GUIDs, also ist das ein Verweis."

#: anno_modding_studio/core/refs.py
#, python-format
msgid "Only %(rate)s%% of the %(n)s value in this field are asset GUIDs, so this may be a coincidence and not a link."
msgid_plural "Only %(rate)s%% of the %(n)s values in this field are asset GUIDs, so this may be a coincidence and not a link."
msgstr[0] "Nur %(rate)s %% des %(n)s Werts in diesem Feld sind Asset-GUIDs, daher ist das vielleicht Zufall und kein Verweis."
msgstr[1] "Nur %(rate)s %% der %(n)s Werte in diesem Feld sind Asset-GUIDs, daher ist das vielleicht Zufall und kein Verweis."

#: anno_modding_studio/core/releases.py
msgid "a major change"
msgstr "eine Änderung für die Hauptversion"

#: anno_modding_studio/core/releases.py
msgid "a minor change"
msgstr "eine Änderung für die Nebenversion"

#: anno_modding_studio/core/releases.py
msgid "a patch change"
msgstr "eine Änderung für die Patch-Version"

#: anno_modding_studio/core/releases.py
msgid "Major change"
msgstr "Änderung für die Hauptversion"

#: anno_modding_studio/core/releases.py
msgid "Minor change"
msgstr "Änderung für die Nebenversion"

#: anno_modding_studio/core/releases.py
msgid "Patch change"
msgstr "Änderung für die Patch-Version"

#: anno_modding_studio/core/releases.py
#, python-format
msgid "An asset this mod added is gone: %(names)s. Saves that built it lose it, and mods that refer to it break."
msgid_plural "%(n)s assets this mod added are gone: %(names)s. Saves that built them lose them, and mods that refer to them break."
msgstr[0] "Ein Asset, das diese Mod hinzugefügt hat, ist weg: %(names)s. Spielstände, in denen es gebaut wurde, verlieren es, und Mods, die darauf verweisen, gehen kaputt."
msgstr[1] "%(n)s Assets, die diese Mod hinzugefügt hat, sind weg: %(names)s. Spielstände, in denen sie gebaut wurden, verlieren sie, und Mods, die darauf verweisen, gehen kaputt."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(n)s new asset: %(names)s."
msgid_plural "%(n)s new assets: %(names)s."
msgstr[0] "%(n)s neues Asset: %(names)s."
msgstr[1] "%(n)s neue Assets: %(names)s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(n)s node added to or taken out of assets."
msgid_plural "%(n)s nodes added to or taken out of assets."
msgstr[0] "%(n)s Knoten in Assets hinzugefügt oder daraus entfernt."
msgstr[1] "%(n)s Knoten in Assets hinzugefügt oder daraus entfernt."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "Changes to %(n)s asset it did not change before: %(names)s."
msgid_plural "Changes to %(n)s assets it did not change before: %(names)s."
msgstr[0] "Änderungen an %(n)s Asset, das sie vorher nicht geändert hat: %(names)s."
msgstr[1] "Änderungen an %(n)s Assets, die sie vorher nicht geändert hat: %(names)s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(n)s change taken out or switched off."
msgid_plural "%(n)s changes taken out or switched off."
msgstr[0] "%(n)s Änderung entfernt oder deaktiviert."
msgstr[1] "%(n)s Änderungen entfernt oder deaktiviert."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(n)s value changed on 1 asset: %(names)s."
msgid_plural "%(n)s values changed on 1 asset: %(names)s."
msgstr[0] "%(n)s Wert an einem Asset geändert: %(names)s."
msgstr[1] "%(n)s Werte an einem Asset geändert: %(names)s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(n)s value changed on %(assets)s assets: %(names)s."
msgid_plural "%(n)s values changed on %(assets)s assets: %(names)s."
msgstr[0] "%(n)s Wert an %(assets)s Assets geändert: %(names)s."
msgstr[1] "%(n)s Werte an %(assets)s Assets geändert: %(names)s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "No changes since %s."
msgstr "Keine Änderungen seit %s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "Since %(since)s: %(kind)s (%(meaning)s)."
msgstr "Seit %(since)s: %(kind)s (%(meaning)s)."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "Since %(since)s: %(kind)s (%(meaning)s). %(current)s covers it."
msgstr "Seit %(since)s: %(kind)s (%(meaning)s). %(current)s deckt das ab."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "Since %(since)s: %(kind)s (%(meaning)s), so the next version is %(version)s."
msgstr "Seit %(since)s: %(kind)s (%(meaning)s), die nächste Version ist also %(version)s."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(kind)s since %(since)s. %(current)s covers it."
msgstr "%(kind)s seit %(since)s. %(current)s deckt das ab."

#: anno_modding_studio/core/releases.py
#, python-format
msgid "%(kind)s since %(since)s (%(meaning)s)."
msgstr "%(kind)s seit %(since)s (%(meaning)s)."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "the base game's %s"
msgstr "%s aus dem Basisspiel"

#: anno_modding_studio/core/repeats.py
msgid "the game finds only one of them, and which one depends on the ops run before"
msgstr "das Spiel findet nur eines davon, und welches, hängt von den zuvor ausgeführten Ops ab"

#: anno_modding_studio/core/repeats.py anno_modding_studio/ui/editor_panel.py
msgid "unnamed"
msgstr "unbenannt"

#: anno_modding_studio/core/repeats.py
msgid "twice in this mod"
msgstr "zweimal in dieser Mod"

#. Translators: in the From column: other collections that list a mod that was already installed.
#: anno_modding_studio/core/repeats.py anno_modding_studio/ui/changes_dock.py anno_modding_studio/ui/mods_folder_dialog.py
#, python-format
msgid "also in %s"
msgstr "auch in %s"

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "GUID %(guid)s (%(names)s): also made by %(others)s, on this PC and not in this loadout. If both load, the game finds only one of them"
msgstr "GUID %(guid)s (%(names)s): auch von %(others)s angelegt, auf diesem PC und nicht in diesem Loadout. Laden beide, findet das Spiel nur eines davon"

#. Translators: the last of a list of where else a GUID is used, after "twice in this mod" or "also in <mods>".
#: anno_modding_studio/core/repeats.py anno_modding_studio/ui/conflicts_dialog.py
#, python-format
msgid "and on this PC by %s"
msgstr "und auf diesem PC von %s"

#: anno_modding_studio/core/repeats.py
msgid "a mod removes all but the last"
msgstr "eine Mod entfernt alle bis auf das letzte"

#: anno_modding_studio/core/repeats.py anno_modding_studio/ui/conflicts_dialog.py
msgid "the same asset each time, so no harm done"
msgstr "jedes Mal dasselbe Asset, also kein Schaden"

#: anno_modding_studio/core/repeats.py anno_modding_studio/ui/conflicts_dialog.py
#, python-format
msgid "the game finds only %s"
msgstr "das Spiel findet nur %s"

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "GUID %(guid)s (%(names)s): %(where)s, %(ending)s"
msgstr "GUID %(guid)s (%(names)s): %(where)s, %(ending)s"

#: anno_modding_studio/core/repeats.py
msgid "Creates assets under a GUID already taken:"
msgstr "Legt Assets unter einer bereits vergebenen GUID an:"

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "%(n)s GUID taken twice"
msgid_plural "%(n)s GUIDs taken twice"
msgstr[0] "%(n)s GUID doppelt vergeben"
msgstr[1] "%(n)s GUIDs doppelt vergeben"

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "GUID %(guid)s is created by the base game and %(mods)s. The game finds only %(found)s."
msgstr "GUID %(guid)s wird vom Basisspiel und von %(mods)s erstellt. Das Spiel findet nur %(found)s."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "GUID %(guid)s is created twice by %(mods)s. The game finds only %(found)s."
msgstr "GUID %(guid)s wird von %(mods)s doppelt erstellt. Das Spiel findet nur %(found)s."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "GUID %(guid)s is created by %(mods)s. The game finds only %(found)s."
msgstr "GUID %(guid)s wird von %(mods)s erstellt. Das Spiel findet nur %(found)s."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "%(n)s GUID is created by the base game and %(mods)s (%(guids)s). The game finds only one of each."
msgid_plural "%(n)s GUIDs are created by the base game and %(mods)s (%(guids)s). The game finds only one of each."
msgstr[0] "%(n)s GUID wird vom Basisspiel und von %(mods)s erstellt (%(guids)s). Das Spiel findet jeweils nur eines."
msgstr[1] "%(n)s GUIDs werden vom Basisspiel und von %(mods)s erstellt (%(guids)s). Das Spiel findet jeweils nur eines."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "%(n)s GUID is created twice by %(mods)s (%(guids)s). The game finds only one of each."
msgid_plural "%(n)s GUIDs are each created twice by %(mods)s (%(guids)s). The game finds only one of each."
msgstr[0] "%(n)s GUID wird von %(mods)s doppelt erstellt (%(guids)s). Das Spiel findet jeweils nur eines."
msgstr[1] "%(n)s GUIDs werden von %(mods)s jeweils doppelt erstellt (%(guids)s). Das Spiel findet jeweils nur eines."

#: anno_modding_studio/core/repeats.py
#, python-format
msgid "%(n)s GUID is created by %(mods)s (%(guids)s). The game finds only one of each."
msgid_plural "%(n)s GUIDs are created by %(mods)s (%(guids)s). The game finds only one of each."
msgstr[0] "%(n)s GUID wird von %(mods)s erstellt (%(guids)s). Das Spiel findet jeweils nur eines."
msgstr[1] "%(n)s GUIDs werden von %(mods)s erstellt (%(guids)s). Das Spiel findet jeweils nur eines."

#: anno_modding_studio/core/saving.py
#, python-format
msgid "A save could not be completed, or undone: %(error)s. The files it was saving are listed in %(journal)s. Close anything that has them open. The Studio tries again the next time it saves or starts."
msgstr "Ein Speichervorgang konnte weder abgeschlossen noch rückgängig gemacht werden: %(error)s. Die Dateien, die er speichern sollte, stehen in %(journal)s. Schließe alles, was sie geöffnet hat. Das Studio versucht es beim nächsten Speichern oder Start erneut."

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%s: not a path inside the mod, so it was not copied"
msgstr "%s: kein Pfad innerhalb der Mod, also wurde die Datei nicht kopiert"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%(file)s: not in %(folder)s, so the mod will ask the game for a file it does not have"
msgstr "%(file)s: nicht in %(folder)s, also verlangt die Mod vom Spiel eine Datei, die es nicht hat"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%s: no scripts folder is set for this mod, so the mod will ask the game for a file it does not have"
msgstr "%s: für diese Mod ist kein Skriptordner festgelegt, also verlangt die Mod vom Spiel eine Datei, die es nicht hat"

#: anno_modding_studio/core/scripts.py
msgid "Runs scripts. What a script does happens while the game runs, and none of it is in the changes shown here."
msgstr "Führt Skripte aus. Was ein Skript tut, geschieht, während das Spiel läuft, und nichts davon steht in den hier gezeigten Änderungen."

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "module %s  (not in its folder)"
msgstr "Modul %s  (nicht in seinem Ordner)"

#. Translators: a Lua module the mod's modinfo lists, by its path.
#: anno_modding_studio/core/scripts.py
#, python-format
msgid "module %s"
msgstr "Modul %s"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "its assets run %(files)s and %(n)s more"
msgid_plural "its assets run %(files)s and %(n)s more"
msgstr[0] "ihre Assets führen %(files)s und %(n)s weitere aus"
msgstr[1] "ihre Assets führen %(files)s und %(n)s weitere aus"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "its assets run %s"
msgstr "ihre Assets führen %s aus"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%(mods)s ship the same %(module)s.lua. One copy is loaded, and it is the same code"
msgstr "%(mods)s liefern dieselbe %(module)s.lua mit. Eine Kopie wird geladen, und es ist derselbe Code"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%(mods)s each ship their own %(module)s.lua. Lua's require keeps one module per name, so one of them is likely to get the other's"
msgstr "%(mods)s liefern jeweils ihre eigene %(module)s.lua mit. Das require von Lua behält pro Name nur ein Modul, also bekommt wahrscheinlich eine der Mods das Modul der anderen"

#. Translators: a global is a Lua variable every script can see.
#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%(mods)s each set the global %(name)s, so one overwrites the other's"
msgstr "%(mods)s setzen jeweils die globale Variable %(name)s, also überschreibt eine den Wert der anderen"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "module %(module)s.lua is also %(mods)s's (the same file)"
msgstr "Modul %(module)s.lua gibt es auch in %(mods)s (dieselbe Datei)"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "module %(module)s.lua is also %(mods)s's"
msgstr "Modul %(module)s.lua gibt es auch in %(mods)s"

#. Translators: a global is a Lua variable every script can see.
#: anno_modding_studio/core/scripts.py
#, python-format
msgid "global %(name)s is also set by %(mods)s"
msgstr "globale Variable %(name)s wird auch von %(mods)s gesetzt"

#: anno_modding_studio/core/scripts.py
#, python-format
msgid "%(n)s script name shared"
msgid_plural "%(n)s script names shared"
msgstr[0] "%(n)s Skriptname geteilt"
msgstr[1] "%(n)s Skriptnamen geteilt"

#: anno_modding_studio/core/sharing.py
msgid "Taken out or switched off. A patch loads after their mod, so it cannot stop their op."
msgstr "Herausgenommen oder ausgeschaltet. Ein Patch lädt nach der Mod und kann deren ModOp nicht aufhalten."

#: anno_modding_studio/core/sharing.py
msgid "A change to one of their groups or included files, which a patch cannot make."
msgstr "Eine Änderung an einer ihrer Gruppen oder eingebundenen Dateien, die ein Patch nicht machen kann."

#: anno_modding_studio/core/sharing.py
msgid "Several of their ops changed at once, which a patch cannot match one by one."
msgstr "Mehrere ihrer ModOps auf einmal geändert, was ein Patch nicht einzeln nachbilden kann."

#: anno_modding_studio/core/sharing.py
msgid "It is in a group of theirs that runs more than once, which a patch cannot match."
msgstr "Sie steht in einer ihrer Gruppen, die mehr als einmal läuft, was ein Patch nicht nachbilden kann."

#: anno_modding_studio/core/sharing.py
msgid "Yours adds or removes, and after theirs it would do that on top of what theirs did."
msgstr "Deine fügt hinzu oder entfernt, und nach ihrer täte sie das zusätzlich zu dem, was ihre getan hat."

#: anno_modding_studio/core/sharing.py
msgid "Theirs adds or removes, and a patch cannot take that back."
msgstr "Ihre fügt hinzu oder entfernt, und ein Patch kann das nicht zurücknehmen."

#: anno_modding_studio/core/sharing.py
msgid "Yours is aimed elsewhere than theirs, so theirs would still change what yours leaves out."
msgstr "Deine zielt woandershin als ihre, also würde ihre weiter ändern, was deine auslässt."

#: anno_modding_studio/core/sharing.py
msgid "Yours runs under another condition than theirs, which a patch cannot match."
msgstr "Deine läuft unter einer anderen Bedingung als ihre, was ein Patch nicht nachbilden kann."

#: anno_modding_studio/core/sharing.py
msgid "A condition looks at the game's files, which their mod has changed by the time a patch runs."
msgstr "Eine Bedingung fragt die Dateien des Spiels ab, die ihre Mod geändert hat, bis ein Patch läuft."

#: anno_modding_studio/core/sharing.py
msgid "It reads a setting of their mod, which a patch does not have."
msgstr "Sie liest eine Einstellung ihrer Mod, die ein Patch nicht hat."

#: anno_modding_studio/core/sharing.py
msgid "Yours works its value out, and after theirs it would start from what theirs left."
msgstr "Deine rechnet ihren Wert aus, und nach ihrer ginge sie von dem aus, was ihre hinterlassen hat."

#: anno_modding_studio/core/sharing.py
msgid "Its search tests what their op sets, so after theirs it may find other nodes."
msgstr "Ihre Suche prüft, was deren ModOp setzt, also findet sie danach womöglich andere Knoten."

#: anno_modding_studio/core/sharing.py
msgid "Yours does not set everything theirs sets, so some of theirs would stay."
msgstr "Deine setzt nicht alles, was ihre setzt, also bliebe ein Teil von ihrer bestehen."

#: anno_modding_studio/core/sharing.py
msgid "A tweak tool switches their op, and an op in your patch would not follow it."
msgstr "Ein Tweak-Tool schaltet ihre ModOp, und eine ModOp in deinem Patch würde dem nicht folgen."

#: anno_modding_studio/core/sharing.py
msgid "A tweak tool sets the value you changed, and your patch would set it over the tool's."
msgstr "Ein Tweak-Tool setzt den Wert, den du geändert hast, und dein Patch würde ihn über den des Tools setzen."

#: anno_modding_studio/core/sharing.py
msgid "It could not be read as XML."
msgstr "Sie ließ sich nicht als XML lesen."

#: anno_modding_studio/core/sharing.py
msgid "It changes a list entry a patch could find only by its place in the list."
msgstr "Sie ändert einen Listeneintrag, den ein Patch nur über seine Stelle in der Liste finden könnte."

#: anno_modding_studio/core/sharing.py
msgid "It is in a group of theirs that is switched off, so it does nothing in game."
msgstr "Sie steht in einer ihrer Gruppen, die ausgeschaltet ist, also bewirkt sie im Spiel nichts."

#: anno_modding_studio/core/sharing.py
msgid "A later op of theirs changes the same thing, and yours would run after it instead of before."
msgstr "Eine spätere ModOp von ihnen ändert dasselbe, und deine liefe danach statt davor."

#. Translators: said of a templates.xml patch; %s names templates.
#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "adds %s"
msgstr "fügt %s hinzu"

#. Translators: said of a templates.xml patch; %s names templates.
#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "changes %s"
msgstr "ändert %s"

#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "changes whatever %(search)s finds (and %(n)s more search)"
msgid_plural "changes whatever %(search)s finds (and %(n)s more searches)"
msgstr[0] "ändert alles, was %(search)s findet (und %(n)s weitere Suche)"
msgstr[1] "ändert alles, was %(search)s findet (und %(n)s weitere Suchen)"

#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "changes whatever %s finds"
msgstr "ändert alles, was %s findet"

#: anno_modding_studio/core/sidefiles.py
msgid "has no ops"
msgstr "hat keine Ops"

#: anno_modding_studio/core/sidefiles.py
msgid "no ops the Studio could make out"
msgstr "keine Ops, die das Studio erkennen konnte"

#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "patches %(file)s: %(n)s op adding %(entries)s"
msgid_plural "patches %(file)s: %(n)s ops adding %(entries)s"
msgstr[0] "patcht %(file)s: %(n)s Op, die %(entries)s hinzufügt"
msgstr[1] "patcht %(file)s: %(n)s Ops, die %(entries)s hinzufügen"

#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "%(n)s entry"
msgid_plural "%(n)s entries"
msgstr[0] "%(n)s Eintrag"
msgstr[1] "%(n)s Einträge"

#: anno_modding_studio/core/sidefiles.py
msgid "its $auto ids are given out when the game loads it"
msgstr "seine $auto-IDs vergibt das Spiel erst beim Laden"

#: anno_modding_studio/core/sidefiles.py
#, python-format
msgid "each has the game read the file it names in its place, and %(link)s reads %(target)s"
msgstr "jede lässt das Spiel an ihrer Stelle die Datei lesen, die sie nennt, und %(link)s liest %(target)s"

#: anno_modding_studio/core/sidefiles.py
msgid "each has the game read the file it names in its place"
msgstr "jede lässt das Spiel an ihrer Stelle die Datei lesen, die sie nennt"

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s loads before it now."
msgstr "%s wird jetzt vor ihr geladen."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, has been read again."
msgstr "%s, die vor ihr geladen wird, wurde neu eingelesen."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s no longer loads before it."
msgstr "%s wird nicht mehr vor ihr geladen."

#: anno_modding_studio/core/stale.py
msgid "The mods before it load in another order."
msgstr "Die Mods vor ihr werden in anderer Reihenfolge geladen."

#: anno_modding_studio/core/stale.py
msgid "It was read on its own, and other mods load before it."
msgstr "Sie wurde für sich allein eingelesen, und andere Mods werden vor ihr geladen."

#: anno_modding_studio/core/stale.py
msgid "It was edited here, and its later ModOps may find something else."
msgstr "Sie wurde hier bearbeitet, und ihre späteren ModOps finden vielleicht etwas anderes vor."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, was edited here."
msgstr "%s, die vor ihr geladen wird, wurde hier bearbeitet."

#: anno_modding_studio/core/stale.py
msgid "Its folder holds another version or build of it than the one read."
msgstr "Ihr Ordner enthält eine andere Version oder einen anderen Build von ihr als den eingelesenen."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, has been updated on disk."
msgstr "%s, die vor ihr geladen wird, wurde auf der Festplatte aktualisiert."

#: anno_modding_studio/core/stale.py
msgid "Restoring the loadout put it back as it was then, and it is read again from its folder."
msgstr "Das Wiederherstellen des Loadouts hat sie so zurückgelegt, wie sie damals war, und sie wird aus ihrem Ordner neu eingelesen."

#: anno_modding_studio/core/stale.py
msgid "It is read from its project, which this loadout has not read yet."
msgstr "Sie wird aus ihrem Projekt eingelesen, das dieses Loadout noch nicht gelesen hat."

#: anno_modding_studio/core/stale.py
msgid "Its project was changed in another loadout since this one read it."
msgstr "Ihr Projekt wurde in einem anderen Loadout geändert, seit dieses es eingelesen hat."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, was changed in its project by another loadout."
msgstr "%s, die vor ihr geladen wird, wurde in ihrem Projekt von einem anderen Loadout geändert."

#: anno_modding_studio/core/stale.py
msgid "A mod of yours keeps edits inside it, and its project was changed in another loadout since this one read it."
msgstr "Eine Mod von dir hält Änderungen darin, und ihr Projekt wurde in einem anderen Loadout geändert, seit dieses es eingelesen hat."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, holds edits a mod of yours keeps, and that mod's project was changed in another loadout."
msgstr "%s, die vor ihr geladen wird, enthält Änderungen, die eine Mod von dir hält, und deren Projekt wurde in einem anderen Loadout geändert."

#: anno_modding_studio/core/stale.py
msgid "Its project is missing, and the library's build of it is read instead."
msgstr "Ihr Projekt fehlt, und stattdessen wird ihr Build aus der Bibliothek eingelesen."

#: anno_modding_studio/core/stale.py
#, python-format
msgid "%s, which loads before it, is read from the library's build of it now."
msgstr "%s, die vor ihr geladen wird, wird jetzt aus ihrem Build in der Bibliothek eingelesen."

#: anno_modding_studio/core/stale.py
msgid "It was read by another version of the Studio, which reads mods differently."
msgstr "Sie wurde von einer anderen Version des Studios eingelesen, die Mods anders liest."

#: anno_modding_studio/core/studio_release.py
msgid "GitHub shows no published release of the Studio yet."
msgstr "GitHub zeigt noch keine veröffentlichte Version des Studios."

#: anno_modding_studio/core/studio_release.py
msgid "GitHub's limit on requests from your address is used up for now. Try again in an hour."
msgstr "GitHubs Grenze für Anfragen von deiner Adresse ist vorerst erreicht. Versuch es in einer Stunde noch einmal."

#: anno_modding_studio/core/studio_release.py
#, python-format
msgid "GitHub answered with status %s. Try again later."
msgstr "GitHub hat mit Status %s geantwortet. Versuch es später noch einmal."

#: anno_modding_studio/core/studio_release.py
#, python-format
msgid "GitHub could not be reached (%s). Check the connection and try again."
msgstr "GitHub war nicht erreichbar (%s). Prüfe die Verbindung und versuch es noch einmal."

#: anno_modding_studio/core/studio_release.py
msgid "GitHub's newest release is a draft or a pre-release, which the Studio doesn't offer."
msgstr "Die neueste Veröffentlichung auf GitHub ist ein Entwurf oder eine Vorabversion. Die bietet das Studio nicht an."

#: anno_modding_studio/core/studio_release.py
msgid "GitHub's answer didn't name a version of the Studio."
msgstr "GitHubs Antwort nannte keine Version des Studios."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "All %(n)s switched on."
msgid_plural "All %(n)s switched on."
msgstr[0] "Alle aktiviert."
msgstr[1] "Alle %(n)s aktiviert."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%(n)s of %(total)s switched off by %(profile)s."
msgid_plural "%(n)s of %(total)s switched off by %(profile)s."
msgstr[0] "%(n)s von %(total)s durch %(profile)s deaktiviert."
msgstr[1] "%(n)s von %(total)s durch %(profile)s deaktiviert."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%(n)s of %(total)s switched off."
msgid_plural "%(n)s of %(total)s switched off."
msgstr[0] "%(n)s von %(total)s deaktiviert."
msgstr[1] "%(n)s von %(total)s deaktiviert."

#: anno_modding_studio/core/switches.py
msgid "No changes to make. Your mods folder already matches."
msgstr "Keine Änderungen nötig. Dein Mod-Ordner ist schon so eingestellt."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "renamed %(n)s folder"
msgid_plural "renamed %(n)s folders"
msgstr[0] "%(n)s Ordner umbenannt"
msgstr[1] "%(n)s Ordner umbenannt"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "switched %(n)s library mod by its link"
msgid_plural "switched %(n)s library mods by their links"
msgstr[0] "%(n)s Bibliotheks-Mod über ihren Link umgeschaltet"
msgstr[1] "%(n)s Bibliotheks-Mods über ihre Links umgeschaltet"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "wrote %(n)s mod into %(profile)s"
msgid_plural "wrote %(n)s mods into %(profile)s"
msgstr[0] "%(n)s Mod in %(profile)s geschrieben"
msgstr[1] "%(n)s Mods in %(profile)s geschrieben"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "wrote %(n)s mod into the profile"
msgid_plural "wrote %(n)s mods into the profile"
msgstr[0] "%(n)s Mod ins Profil geschrieben"
msgstr[1] "%(n)s Mods ins Profil geschrieben"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "took %(n)s mod out of activation.json"
msgid_plural "took %(n)s mods out of activation.json"
msgstr[0] "%(n)s Mod aus activation.json genommen"
msgstr[1] "%(n)s Mods aus activation.json genommen"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%(n)s could not be changed"
msgid_plural "%(n)s could not be changed"
msgstr[0] "%(n)s ließ sich nicht ändern"
msgstr[1] "%(n)s ließen sich nicht ändern"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "Your mods folder was not switched: %s."
msgstr "Dein Mod-Ordner wurde nicht umgestellt: %s."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "Switched your mods folder to match: %s."
msgstr "Mod-Ordner entsprechend umgestellt: %s."

#: anno_modding_studio/core/switches.py
#, python-format
msgid "it is bundled inside %s, and switches with it"
msgstr "sie wird in %s mitgeliefert und mit ihr umgeschaltet"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%s lists it by another name"
msgstr "%s führt sie unter einem anderen Namen"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%s is already there"
msgstr "%s gibt es schon"

#: anno_modding_studio/core/switches.py
msgid "there is no mod profile to write to"
msgstr "es gibt kein Mod-Profil, in das geschrieben werden kann"

#: anno_modding_studio/core/switches.py
#, python-format
msgid "%(others)s declares the same ModID, and the profile switches both with one line"
msgid_plural "%(others)s declare the same ModID, and the profile switches them all with one line"
msgstr[0] "%(others)s gibt dieselbe ModID an, und das Profil schaltet beide mit einer Zeile"
msgstr[1] "%(others)s geben dieselbe ModID an, und das Profil schaltet alle mit einer Zeile"

#: anno_modding_studio/core/texts.py
#, python-format
msgid "%s: not a ModOps file, so the names were not added to it"
msgstr "%s: keine ModOps-Datei, daher wurden die Namen dort nicht eingetragen"

#. Translators: stands in for a profile's name in "Matches …" and "Playing … changes 3".
#. Translators: "Matched by" this loadout, which remembered the match.
