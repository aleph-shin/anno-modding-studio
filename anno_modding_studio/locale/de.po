#, python-format
msgctxt "stored"
msgid "create asset %(guid)s (%(name)s)"
msgstr "Asset %(guid)s anlegen (%(name)s)"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "replayed as written it does not land on %(n)d of its assets the way the changes shown say (%(some)s and others)"
msgstr "unverändert wieder abgespielt, landet sie bei %(n)d ihrer Assets nicht so, wie es die gezeigten Änderungen sagen (%(some)s und weitere)"

#: anno_modding_studio/core/reader.py
#, python-format
msgctxt "stored"
msgid "replayed as written it does not land on %s the way the changes shown say"
msgstr "unverändert wieder abgespielt, landet sie bei %s nicht so, wie es die gezeigten Änderungen sagen"

#: anno_modding_studio/core/reader.py
#, python-format
msgid "No file in %s patches assets.xml."
msgstr "Keine Datei in %s patcht die assets.xml."

