#: anno_modding_studio/ui/about_dialog.py
#, python-format
msgid "About %s"
msgstr "Über %s"

#: anno_modding_studio/ui/about_dialog.py anno_modding_studio/ui/folders_dialog.py
#, python-format
msgid "Version %s"
msgstr "Version %s"

#: anno_modding_studio/ui/about_dialog.py
msgid "<p>A workshop for Anno mods. It plays a set of mods, changes a mod you downloaded, and builds a mod of your own.</p><p>It reads the game's files and writes each change as its own narrow ModOp, so mods that change different parts of the same asset work together.</p><p>Mods are looked up, installed and published through <a href=\"https://mod.io\">mod.io</a>, with your own mod.io account. The mod.io name and logo belong to mod.io and are used under its API terms.</p>"
msgstr "<p>Eine Werkstatt für Anno-Mods. Sie spielt eine Auswahl von Mods, ändert eine Mod, die du heruntergeladen hast, und baut deine eigene Mod.</p><p>Sie liest die Dateien des Spiels und schreibt jede Änderung als eigene, eng gefasste ModOp, sodass sich Mods vertragen, die verschiedene Teile desselben Assets ändern.</p><p>Mods werden über <a href=\"https://mod.io\">mod.io</a> gesucht, installiert und veröffentlicht, mit deinem eigenen mod.io-Konto. Name und Logo von mod.io gehören mod.io und werden gemäß dessen API-Bedingungen verwendet.</p>"

#: anno_modding_studio/ui/about_dialog.py
#, python-format
msgid "%(copyright)s. Licensed under the <a href=\"%(licence)s\">GNU General Public License v3 or later</a>. It comes with ABSOLUTELY NO WARRANTY."
msgstr "%(copyright)s. Lizenziert unter der <a href=\"%(licence)s\">GNU General Public License v3 oder später</a>. Es wird OHNE JEDE GEWÄHRLEISTUNG bereitgestellt."

#: anno_modding_studio/ui/about_dialog.py
#, python-format
msgid "<a href=\"%(notices)s\">Third-party notices</a> &nbsp;·&nbsp; <a href=\"%(credits)s\">Credits</a> &nbsp;·&nbsp; <a href=\"%(source)s\">Source code on GitHub</a>"
msgstr "<a href=\"%(notices)s\">Hinweise zu Drittanbietern</a> &nbsp;·&nbsp; <a href=\"%(credits)s\">Danksagungen</a> &nbsp;·&nbsp; <a href=\"%(source)s\">Quellcode auf GitHub</a>"

